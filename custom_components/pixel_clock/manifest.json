{
  "domain": "pixel_clock",
  "name": "Pixel Clock (iPixel Color)",
  "bluetooth": [
    {
      "local_name": "LED_BLE_*",
      "connectable": true
    }
  ],
  "codeowners": ["@dominguez-posh"],
  "config_flow": true,
  "dependencies": ["bluetooth_adapters"],
  "after_dependencies": ["calendar"],
  "documentation": "https://github.com/dominguez-posh/ha-pixelclock",
  "integration_type": "device",
  "iot_class": "local_push",
  "issue_tracker": "https://github.com/dominguez-posh/ha-pixelclock/issues",
  "requirements": ["Pillow>=10.0.0"],
  "version": "0.2.0"
}
