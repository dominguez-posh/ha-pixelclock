        "icon": { "name": "Icon", "description": "Eingebauter Name, LaMetric-Icon-ID oder Bilddatei." },
        "color": { "name": "Farbe", "description": "Textfarbe." },
        "progress": { "name": "Fortschritt", "description": "Fortschrittsbalken 0-100 %." },
        "progress_color": { "name": "Fortschrittsfarbe", "description": "Farbe des Fortschrittsbalkens." },
        "lifetime": { "name": "Lebensdauer", "description": "App entfernen, wenn sie so viele Sekunden nicht aktualisiert wurde." }
      }
    },
    "remove_app": {
      "name": "App entfernen",
      "description": "Entfernt eine mit set_app angelegte App.",
