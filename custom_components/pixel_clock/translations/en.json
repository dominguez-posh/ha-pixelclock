{
  "config": {
    "flow_title": "{name}",
    "step": {
      "bluetooth_confirm": {
        "description": "Add {name} ({address}, {size} pixels)?"
      },
      "user": {
        "data": {
          "address": "Panel"
        }
      }
    },
    "abort": {
      "already_configured": "This panel is already configured.",
      "no_devices_found": "No iPixel panel (LED_BLE_…) in range of a connectable Bluetooth adapter.",
      "not_supported": "Not an iPixel panel."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Panel settings",
        "description": "Add the pages themselves under the integration with \"Add page\".",
        "data": {
          "color": "Default text colour"
        }
      }
    }
  },
  "entity": {
    "button": {
      "next_app": {
        "name": "Next app"
      },
      "dismiss": {
        "name": "Dismiss notification"
      }
    },
    "image": {
      "preview": {
        "name": "Preview"
      }
    },
    "number": {
      "app_duration": {
        "name": "App duration"
      }
    },
    "select": {
      "mode": {
        "name": "Mode",
        "state": {
          "apps": "Apps",
          "native_clock": "Built-in clock"
        }
      },
      "clock_style": {
        "name": "Built-in clock face"
      },
      "orientation": {
        "name": "Orientation",
        "state": {
          "landscape": "Landscape",
          "portrait_left": "Portrait (left end on top)",
          "portrait_right": "Portrait (right end on top)",
          "upside_down": "Landscape, upside down"
        }
      }
    },
    "sensor": {
      "current_app": {
        "name": "Current app"
      },
      "panel": {
        "name": "Panel"
      }
    },
    "switch": {
      "auto_rotate": {
        "name": "Rotate apps"
      },
      "page_custom": {
        "name": "Automation page {name}"
      },
      "app": {
        "name": "Page {name}"
      }
    },
    "text": {
      "message": {
        "name": "Message"
      }
    }
  },
  "exceptions": {
    "no_device": {
      "message": "No Pixel Clock found."
    }
  },
  "services": {
    "notify": {
      "name": "Notify",
      "description": "Show a notification right away; the app rotation continues afterwards.",
      "fields": {
        "device_id": {
          "name": "Panel",
          "description": "Panels to use (default: all)."
        },
        "text": {
          "name": "Text",
          "description": "Text; a line break gives two lines. Long text scrolls."
        },
        "icon": {
          "name": "Icon",
          "description": "Built-in name (bell, power, sun, calendar, warning, heart, …), LaMetric icon id or image file path."
        },
        "color": {
          "name": "Colour",
          "description": "Text colour."
        },
        "duration": {
          "name": "Duration",
          "description": "Seconds (default 10 s or one scroll pass)."
        },
        "progress": {
          "name": "Progress",
          "description": "Progress bar 0-100 %."
        },
        "progress_color": {
          "name": "Progress colour",
          "description": "Colour of the progress bar."
        },
        "effect": {
          "name": "Effect",
          "description": "Animated background or rainbow text."
        }
      }
    },
    "set_app": {
      "name": "Set app",
      "description": "Create or update an app in the rotation. The text may contain templates, rendered every time the app is shown.",
      "fields": {
        "device_id": {
          "name": "Panel",
          "description": "Panels to use (default: all)."
        },
        "name": {
          "name": "Name",
          "description": "Unique app name (lower case, no spaces)."
        },
        "text": {
          "name": "Text",
          "description": "Text or template; a line break gives two lines."
        },
        "icon": {
          "name": "Icon",
          "description": "Built-in name, LaMetric icon id or image file path."
        },
        "color": {
          "name": "Colour",
          "description": "Text colour."
        },
        "progress": {
          "name": "Progress",
          "description": "Progress bar 0-100 %."
        },
        "progress_color": {
          "name": "Progress colour",
          "description": "Colour of the progress bar."
        },
        "lifetime": {
          "name": "Lifetime",
          "description": "Remove the app when it was not updated for this many seconds."
        },
        "effect": {
          "name": "Effect",
          "description": "Animated background or rainbow text."
        }
      }
    },
    "remove_app": {
      "name": "Remove app",
      "description": "Remove an app created with set_app.",
      "fields": {
        "device_id": {
          "name": "Panel",
          "description": "Panels to use (default: all)."
        },
        "name": {
          "name": "Name",
          "description": "App name."
        }
      }
    },
    "dismiss": {
      "name": "Dismiss notification",
      "description": "End the notification currently shown.",
      "fields": {
        "device_id": {
          "name": "Panel",
          "description": "Panels to use (default: all)."
        }
      }
    }
  },
  "config_subentries": {
    "app": {
      "entry_type": "Page",
      "initiate_flow": {
        "user": "Add page",
        "reconfigure": "Edit page"
      },
      "step": {
        "user": {
          "title": "New page",
          "description": "What should the page show?",
          "data": {
            "type": "Kind of page"
          }
        },
        "app": {
          "title": "Set up page",
          "data": {
            "name": "Name",
            "icon": "Icon",
            "color": "Text colour",
            "effect": "Background effect",
            "entity": "Entity",
            "seconds": "Show seconds",
            "weekday_bar": "Weekday bar",
            "label": "Text before",
            "unit": "Unit",
            "decimals": "Decimals",
            "progress": "Progress bar",
            "min": "Bar minimum",
            "max": "Bar maximum",
            "active_states": "Active in state",
            "above": "Active above value",
            "off_delay": "Hold time",
            "text": "Text",
            "progress_entity": "Progress from entity",
            "done_text": "Message at the end",
            "calendars": "Calendars",
            "days": "Look ahead (days)"
          },
          "data_description": {
            "icon": "Built-in icon, LaMetric icon number or image file (/config/www/…).",
            "color": "Empty = the panel's default text colour.",
            "label": "Optional, e.g. \"Inside\".",
            "unit": "Empty = unit of the entity.",
            "decimals": "Empty = automatic.",
            "active_states": "The page shows in these states, e.g. on, run, charging.",
            "above": "Or: the page shows while the value is above, e.g. power > 5 W.",
            "off_delay": "The page stays this long after the end (washing machine pauses).",
            "text": "Empty = page name. Templates allowed, e.g. {{ states('sensor.remaining') }} min.",
            "done_text": "Optional: notification when the status ends, e.g. \"Washing machine done!\"."
          }
        }
      },
      "error": {
        "status_condition": "Please set \"Active in state\" or \"Active above value\"."
      }
    }
  },
