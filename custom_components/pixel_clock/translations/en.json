{
  "config": {
    "flow_title": "{name}",
    "step": {
      "bluetooth_confirm": {
        "description": "Add {name} ({address}, {size} pixels)?"
      },
      "user": {
        "data": {
          "address": "Panel"
        }
      }
    },
    "abort": {
      "already_configured": "This panel is already configured.",
      "no_devices_found": "No iPixel panel (LED_BLE_…) in range of a connectable Bluetooth adapter.",
      "not_supported": "Not an iPixel panel."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Apps on the panel",
        "data": {
          "show_clock": "Clock",
          "show_date": "Date",
          "weather_entity": "Weather",
          "power_entity": "Power consumption (W, negative = feed-in)",
          "calendar_entities": "Calendars (next appointment)",
          "calendar_days": "Look ahead (days)",
          "sensor_entities": "Further values (one app each)",
          "color": "Text colour"
        }
      }
    }
  },
  "entity": {
    "button": {
      "next_app": {
        "name": "Next app"
      },
      "dismiss": {
        "name": "Dismiss notification"
      }
    },
    "image": {
      "preview": {
        "name": "Preview"
      }
    },
    "number": {
      "app_duration": {
        "name": "App duration"
      }
    },
    "select": {
      "mode": {
        "name": "Mode",
        "state": {
          "apps": "Apps",
          "native_clock": "Built-in clock"
        }
      },
      "clock_style": {
        "name": "Built-in clock face"
      },
      "orientation": {
        "name": "Orientation",
        "state": {
          "landscape": "Landscape",
          "portrait_left": "Portrait (left end on top)",
          "portrait_right": "Portrait (right end on top)",
          "upside_down": "Landscape, upside down"
        }
      },
      "source_weather": {
        "name": "Weather source"
      },
      "source_power": {
        "name": "Power source"
      },
      "source_calendar": {
        "name": "Appointments source"
      }
    },
    "sensor": {
      "current_app": {
        "name": "Current app"
      },
      "panel": {
        "name": "Panel"
      }
    },
    "switch": {
      "auto_rotate": {
        "name": "Rotate apps"
      },
      "page_clock": {
        "name": "Page clock"
      },
      "page_date": {
        "name": "Page date"
      },
      "page_weather": {
        "name": "Page weather"
      },
      "page_power": {
        "name": "Page power"
      },
      "page_calendar": {
        "name": "Page appointments"
      },
      "page_custom": {
        "name": "Page {name}"
      }
    },
    "text": {
      "message": {
        "name": "Message"
      }
    }
  },
  "exceptions": {
    "no_device": {
      "message": "No Pixel Clock found."
    }
  },
  "services": {
    "notify": {
      "name": "Notify",
      "description": "Show a notification right away; the app rotation continues afterwards.",
      "fields": {
        "device_id": {
          "name": "Panel",
          "description": "Panels to use (default: all)."
        },
        "text": {
          "name": "Text",
          "description": "Text; a line break gives two lines. Long text scrolls."
        },
        "icon": {
          "name": "Icon",
          "description": "Built-in name (bell, power, sun, calendar, warning, heart, …), LaMetric icon id or image file path."
        },
        "color": {
          "name": "Colour",
          "description": "Text colour."
        },
        "duration": {
          "name": "Duration",
          "description": "Seconds (default 10 s or one scroll pass)."
        },
        "progress": {
          "name": "Progress",
          "description": "Progress bar 0-100 %."
        },
        "progress_color": {
          "name": "Progress colour",
          "description": "Colour of the progress bar."
        }
      }
    },
    "set_app": {
      "name": "Set app",
      "description": "Create or update an app in the rotation. The text may contain templates, rendered every time the app is shown.",
      "fields": {
        "device_id": {
          "name": "Panel",
          "description": "Panels to use (default: all)."
        },
        "name": {
          "name": "Name",
          "description": "Unique app name (lower case, no spaces)."
        },
        "text": {
          "name": "Text",
          "description": "Text or template; a line break gives two lines."
        },
        "icon": {
          "name": "Icon",
          "description": "Built-in name, LaMetric icon id or image file path."
        },
        "color": {
          "name": "Colour",
          "description": "Text colour."
        },
        "progress": {
          "name": "Progress",
          "description": "Progress bar 0-100 %."
        },
        "progress_color": {
          "name": "Progress colour",
          "description": "Colour of the progress bar."
        },
        "lifetime": {
          "name": "Lifetime",
          "description": "Remove the app when it was not updated for this many seconds."
        }
      }
    },
    "remove_app": {
      "name": "Remove app",
      "description": "Remove an app created with set_app.",
      "fields": {
        "device_id": {
          "name": "Panel",
          "description": "Panels to use (default: all)."
        },
        "name": {
          "name": "Name",
          "description": "App name."
        }
      }
    },
    "dismiss": {
      "name": "Dismiss notification",
      "description": "End the notification currently shown.",
      "fields": {
        "device_id": {
          "name": "Panel",
          "description": "Panels to use (default: all)."
        }
      }
    }
  }
}
